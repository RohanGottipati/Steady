# Tiger Data - server only
TIGER_DATABASE_URL=
TIGER_DATABASE_SSL=require

# Optional Tiger Cloud development metadata; never expose credentials client-side
TIGER_PROJECT_ID=
TIGER_SERVICE_ID=

# Backboard - server only
BACKBOARD_API_KEY=
BACKBOARD_MODEL_PROVIDER=google
BACKBOARD_MODEL_NAME=gemini-2.5-flash

# ElevenLabs - server only
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
# Enable the server speech route (the public voice flag alone is insufficient)
SPEECH_ENABLED=false
# Optional speech-route rate limit (defaults: 20 requests per 60000 ms)
# SPEECH_RATE_LIMIT=20
# SPEECH_RATE_WINDOW_MS=60000

# Public non-secret feature flags
NEXT_PUBLIC_DEBUG_DEFAULT=false
NEXT_PUBLIC_ENABLE_AI_REVIEW=true
NEXT_PUBLIC_ENABLE_VOICE=true
NEXT_PUBLIC_ENABLE_CLOUD_SYNC=true
NEXT_PUBLIC_DEMO_FIXTURE_MODE=false
# Natural palms-down mapping; false selects the temporary legacy fallback
NEXT_PUBLIC_SURGICAL_POSTURE_MAPPING=true
