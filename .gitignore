# Dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Build / Next.js
.next/
.next-e2e/
out/
build/
dist/
*.tsbuildinfo
next-env.d.ts

# Env / secrets
.env
.env.*
!.env.example
# Exported git-crypt keys must stay outside version control.
*.git-crypt-key

# Vercel
.vercel

# OS / editor
.DS_Store
*.pem
.idea/
.vscode/
*.swp

# Test / coverage
coverage/
playwright-report/
test-results/
artifacts/demo/
blob-report/
playwright/.cache/

# Logs / debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Raw datasets (licensing gate — do not commit)
datasets/
raw-data/
data/raw/
**/jigsaws/raw/
**/lask/raw/
**/shands/raw/

# Large binary assets (tracked via public/.gitkeep until licensed)
public/mediapipe/wasm/
public/mediapipe/runtime.json
public/mediapipe/*.tmp
*.task
!public/mediapipe/.gitkeep
*.glb
# Licensed, documented runtime models (see docs/ASSET_LICENSES.md).
!public/models/patient/*.glb
*.gltf
*.bin
*.mp4
*.webm
*.wav
*.mp3
# B7: pre-generated coaching voice clips are committed assets (small, demo-critical).
!public/audio/coach/*.mp3

# Python
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/

# Generated UI and scoped live-service acceptance evidence
/artifacts/acceptance/
