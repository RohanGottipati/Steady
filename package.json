{
  "name": "steady",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prepare:vision": "node scripts/setup/prepare-vision.mjs",
    "predev": "npm run prepare:vision",
    "prebuild": "npm run prepare:vision",
    "dev": "next dev --webpack",
    "dev:turbo": "next dev --turbopack",
    "predev:turbo": "npm run prepare:vision",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:db": "STEADY_TIGER_INTEGRATION=1 vitest run tests/unit/b0-tiger-bootstrap.test.ts tests/unit/health-db.test.ts tests/unit/b12-tiger-search.test.ts",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "demo:record": "node scripts/demo/record-backup.mjs",
    "verify:ai": "node scripts/setup/verify-ai-services.mjs",
    "audio:coach": "node --experimental-strip-types scripts/audio/generate-coach-clips.mjs",
    "db:migrate": "node scripts/tiger/migrate.mjs",
    "db:seed": "node scripts/tiger/seed.mjs",
    "test:live": "node scripts/verify/live-smoke.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.1.1",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "idb": "^8.0.4",
    "lucide-react": "^1.58.0",
    "next": "16.4.2",
    "postgres": "^3.4.9",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.7.0",
    "three": "^0.186.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.5.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "description": "Hardware-free AI surgical motion trainer"
}
